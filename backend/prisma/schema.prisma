generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Recurrence {
  NONE
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

model User {
  id           Int              @id @default(autoincrement())
  username     String           @unique
  email        String           @unique
  passwordHash String
  createdAt    DateTime         @default(now())
  subjects     Subject[]
  tasks        Task[]
  sessions     AuthSession[]
  settings     UserSettings?
  studyLogs    StudyLog[]
  studyTimer   StudyTimer?
}

model AuthSession {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSettings {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  theme           Theme     @default(SYSTEM)
  weekStartsOn    Int       @default(1)
  defaultPage     String    @default("today")
  showCompleted   Boolean   @default(true)
  morningCheckIn  Boolean   @default(true)
  lastCheckInAt   DateTime?
  automaticBackup Boolean   @default(false)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id          Int       @id @default(autoincrement())
  userId      Int
  name        String
  description String?
  color       String    @default("#65725b")
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@unique([userId, name])
  @@index([userId, archivedAt])
}

model StudyLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  date          String
  targetMinutes Int      @default(0)
  actualMinutes Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model StudyTimer {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  logDate        String
  status         String    @default("RUNNING")
  startedAt      DateTime?
  elapsedSeconds Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id                 Int        @id @default(autoincrement())
  userId             Int
  subjectId          Int?
  title              String
  description        String?
  status             TaskStatus @default(TODO)
  priority           Priority   @default(MEDIUM)
  scheduledDate      DateTime?
  dueDate            DateTime?
  estimatedMinutes   Int?
  important          Boolean    @default(false)
  recurrence         Recurrence @default(NONE)
  recurrenceSourceId Int?
  position           Float      @default(0)
  rescheduleCount    Int        @default(0)
  completedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject            Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  entries            TaskEntry[]

  @@index([userId, scheduledDate])
  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([subjectId])
}

model TaskEntry {
  id        Int      @id @default(autoincrement())
  taskId    Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}
