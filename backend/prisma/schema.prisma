generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Recurrence {
  NONE
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

model User {
  id           Int              @id @default(autoincrement())
  username     String           @unique
  email        String           @unique
  passwordHash String
  createdAt    DateTime         @default(now())
  subjects     Subject[]
  tasks        Task[]
  sessions     AuthSession[]
  settings     UserSettings?
  vault        VaultConnection?
}

model AuthSession {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSettings {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  theme           Theme     @default(SYSTEM)
  weekStartsOn    Int       @default(1)
  defaultPage     String    @default("today")
  showCompleted   Boolean   @default(true)
  morningCheckIn  Boolean   @default(true)
  lastCheckInAt   DateTime?
  automaticBackup Boolean   @default(false)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id          Int       @id @default(autoincrement())
  userId      Int
  name        String
  description String?
  color       String    @default("#65725b")
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@unique([userId, name])
  @@index([userId, archivedAt])
}

model Task {
  id                 Int        @id @default(autoincrement())
  userId             Int
  subjectId          Int?
  title              String
  description        String?
  status             TaskStatus @default(TODO)
  priority           Priority   @default(MEDIUM)
  scheduledDate      DateTime?
  dueDate            DateTime?
  estimatedMinutes   Int?
  important          Boolean    @default(false)
  recurrence         Recurrence @default(NONE)
  recurrenceSourceId Int?
  position           Float      @default(0)
  rescheduleCount    Int        @default(0)
  completedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject            Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  noteLinks          TaskNote[]

  @@index([userId, scheduledDate])
  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([subjectId])
}

model VaultConnection {
  id              Int               @id @default(autoincrement())
  userId          Int               @unique
  name            String
  rootFingerprint String
  status          String            @default("READY")
  lastIndexedAt   DateTime?
  lastError       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes           VaultNote[]
  tags            VaultTag[]
  attachments     VaultAttachment[]
}

model VaultNote {
  id             Int             @id @default(autoincrement())
  vaultId        Int
  relativePath   String
  normalizedPath String
  title          String
  folder         String
  contentHash    String
  size           Int
  modifiedAt     DateTime
  metadataJson   String          @default("{}")
  aliasesJson    String          @default("[]")
  isMap          Boolean         @default(false)
  isTemplate     Boolean         @default(false)
  available      Boolean         @default(true)
  indexedAt      DateTime        @default(now())
  vault          VaultConnection @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  properties     VaultProperty[]
  tags           VaultNoteTag[]
  outgoingLinks  VaultLink[]     @relation("OutgoingLinks")
  incomingLinks  VaultLink[]     @relation("IncomingLinks")
  taskLinks      TaskNote[]

  @@unique([vaultId, normalizedPath])
  @@index([vaultId, title])
  @@index([vaultId, folder])
  @@index([vaultId, contentHash])
}

model VaultProperty {
  id             Int       @id @default(autoincrement())
  noteId         Int
  name           String
  normalizedName String
  value          String
  valueType      String
  note           VaultNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, normalizedName])
  @@index([normalizedName, value])
}

model VaultTag {
  id             Int             @id @default(autoincrement())
  vaultId        Int
  normalizedName String
  displayName    String
  vault          VaultConnection @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  notes          VaultNoteTag[]

  @@unique([vaultId, normalizedName])
}

model VaultNoteTag {
  noteId Int
  tagId  Int
  note   VaultNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    VaultTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
}

model VaultAttachment {
  id             Int             @id @default(autoincrement())
  vaultId        Int
  relativePath   String
  normalizedPath String
  extension      String
  mimeType       String
  size           Int
  modifiedAt     DateTime
  available      Boolean         @default(true)
  vault          VaultConnection @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  links          VaultLink[]

  @@unique([vaultId, normalizedPath])
  @@index([vaultId, normalizedPath])
}

model VaultLink {
  id                 Int              @id @default(autoincrement())
  sourceNoteId       Int
  targetNoteId       Int?
  targetAttachmentId Int?
  rawTarget          String
  normalizedTarget   String
  heading            String?
  blockId            String?
  kind               String
  embedded           Boolean          @default(false)
  resolved           Boolean          @default(false)
  sourceNote         VaultNote        @relation("OutgoingLinks", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetNote         VaultNote?       @relation("IncomingLinks", fields: [targetNoteId], references: [id], onDelete: SetNull)
  targetAttachment   VaultAttachment? @relation(fields: [targetAttachmentId], references: [id], onDelete: SetNull)

  @@index([sourceNoteId])
  @@index([targetNoteId])
  @@index([targetAttachmentId])
}

model TaskNote {
  taskId    Int
  noteId    Int
  createdAt DateTime  @default(now())
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  note      VaultNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([taskId, noteId])
  @@index([noteId])
}
